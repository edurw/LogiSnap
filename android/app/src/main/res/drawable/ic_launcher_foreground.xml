<?xml version="1.0" encoding="utf-8"?>
<!--
    Porta AND: aresta reta à esquerda e semicírculo à direita, com duas
    entradas e uma saída.

    O viewport do ícone adaptativo é 108x108, mas o Android recorta as bordas
    conforme a máscara do aparelho (círculo, quadrado arredondado, etc.), então
    o desenho fica entre 20 e 88 para caber na zona segura de 72x72.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Corpo da porta -->
    <path
        android:pathData="M34,34 H54 A20,20 0 0 1 54,74 H34 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineJoin="round" />

    <!-- Duas entradas à esquerda e a saída à direita -->
    <path
        android:pathData="M20,44 H34 M20,64 H34 M74,54 H88"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
</vector>
